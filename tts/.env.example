KITTENML_API_KEY=sk_kitten_live_...
# Optional. The examples default to Kitten TTS 2 and its "eleanor_en" voice.
# KITTENML_TTS_MODEL=kitten-tts-2-latest
# KITTENML_TTS_VOICE="maeve_en"
# Or one of your saved voices, by its ID:
# KITTENML_TTS_VOICE=voice_0123456789abcdef0123456789abcdef
# Kitten TTS 2 only: quality over speed in the complete-response examples.
# KITTENML_TTS_STREAM=false
# For a KittenTTS 0.8 model, use one of its own voices:
# KITTENML_TTS_MODEL=kitten-tts-mini-0.8
# KITTENML_TTS_VOICE=Bella
